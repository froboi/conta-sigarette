# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Keep 1 when served through HTTPS by Nginx Proxy Manager.
SESSION_COOKIE_SECURE=1

# Number of days for sessions created with "Rimani connesso".
SESSION_LIFETIME_DAYS=30

# Host port exposed to Nginx Proxy Manager.
QUITSTATS_PORT=5000
